# Agent Chrome Configuration

# Port for Chrome DevTools Protocol (CDP)
CHROME_CDP_PORT=9222

# Port for Local OpenAI-compatible Bridge Server
BRIDGE_SERVER_PORT=8000

# Directory path for dedicated Agent Chrome user profile
# Windows: %USERPROFILE%\.agent-chrome-profile
# macOS:   ~/.agent-chrome-profile
# Linux:   ~/.agent-chrome-profile
AGENT_CHROME_PROFILE_DIR=~/.agent-chrome-profile

# Optional: Freebuff Desktop Orchestrator URL
FREEBUFF_API_URL=http://127.0.0.1:8787
